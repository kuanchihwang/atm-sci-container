<?xml version="1.0"?>
<config_machines version="3.0">
  <machine MACH="atm-sci-container">
    <DESC>
      High-performance computing (HPC) containers for performance-portable and reproducible atmospheric modeling.
    </DESC>
    <OS>LINUX</OS>
    <COMPILERS>gnu,intel</COMPILERS>
    <MPILIBS compiler="gnu">open-mpi,mpich</MPILIBS>
    <MPILIBS compiler="intel">open-mpi,mpich,intel-mpi</MPILIBS>
    <CIME_OUTPUT_ROOT>/working/cesm-output-root</CIME_OUTPUT_ROOT>
    <DIN_LOC_ROOT>/working/cesm-data-root/inputdata</DIN_LOC_ROOT>
    <DIN_LOC_ROOT_CLMFORC>/working/cesm-data-root/inputdata/atm/datm7</DIN_LOC_ROOT_CLMFORC>
    <DOUT_S_ROOT>$CIME_OUTPUT_ROOT/archive/$CASE</DOUT_S_ROOT>
    <CCSM_CPRNC>cprnc</CCSM_CPRNC>
    <GMAKE>make</GMAKE>
    <GMAKE_J>4</GMAKE_J>
    <BATCH_SYSTEM>none</BATCH_SYSTEM>
    <SUPPORTED_BY>
      Kuan-Chih Wang, https://github.com/kuanchihwang
    </SUPPORTED_BY>
    <MAX_TASKS_PER_NODE>$ENV{CESM_NTASKS_PER_NODE}</MAX_TASKS_PER_NODE>
    <MAX_MPITASKS_PER_NODE>$ENV{CESM_NTASKS_PER_NODE}</MAX_MPITASKS_PER_NODE>
    <PROJECT_REQUIRED>FALSE</PROJECT_REQUIRED>
    <mpirun mpilib="open-mpi">
      <executable>mpirun</executable>
      <arguments>
        <arg>-n {{ total_tasks }}</arg>
      </arguments>
    </mpirun>
    <mpirun mpilib="mpich">
      <executable>mpiexec</executable>
      <arguments>
        <arg>-n {{ total_tasks }}</arg>
      </arguments>
    </mpirun>
    <mpirun mpilib="intel-mpi">
      <executable>mpiexec</executable>
      <arguments>
        <arg>-n {{ total_tasks }}</arg>
      </arguments>
    </mpirun>
    <module_system type="none">
    </module_system>
    <environment_variables>
      <env name="PNETCDF_PATH">$ENV{PNETCDF}</env>
      <env name="NETCDF_PATH">$ENV{NETCDF}</env>
      <env name="PIO_PATH">$ENV{PIO}</env>
      <env name="PIO_INCDIR">$ENV{PIO}/include</env>
      <env name="PIO_LIBDIR">$ENV{PIO}/lib</env>
      <env name="PIO_TYPENAME_VALID_VALUES">netcdf,pnetcdf,netcdf4c,netcdf4p</env>
      <env name="PIO_VERSION_MAJOR">2</env>
      <env name="PIO_VERSION_MINOR">6</env>
      <env name="PIO_VERSION_PATCH">10</env>
    </environment_variables>
    <environment_variables comp_interface="nuopc">
      <env name="ESMF_RUNTIME_PROFILE">ON</env>
      <env name="ESMF_RUNTIME_PROFILE_OUTPUT">SUMMARY</env>
    </environment_variables>
  </machine>
</config_machines>
