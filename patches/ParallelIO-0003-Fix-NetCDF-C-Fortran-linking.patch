From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kuan-Chih Wang <kuanchihwang@outlook.com>
Date: Sun, 3 May 2026 09:13:36 +0800
Subject: [PATCH] Fix NetCDF-{C,Fortran} linking

---
 src/clib/CMakeLists.txt | 2 +-
 src/flib/CMakeLists.txt | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/clib/CMakeLists.txt b/src/clib/CMakeLists.txt
index 18c64b5..e2e8a39 100644
--- a/src/clib/CMakeLists.txt
+++ b/src/clib/CMakeLists.txt
@@ -130,7 +130,7 @@ if (NetCDF_C_FOUND)
   target_include_directories (pioc
     PUBLIC ${NetCDF_C_INCLUDE_DIRS})
   target_link_libraries (pioc
-    PUBLIC ${NetCDF_C_LIBRARIES})
+    PUBLIC ${NetCDF_C_LINK_LIBRARIES})
   if (${NetCDF_C_LOGGING_ENABLED})
     # netcdf.h needs this to be defined to use netCDF logging.
     target_compile_definitions (pioc
diff --git a/src/flib/CMakeLists.txt b/src/flib/CMakeLists.txt
index 6adac28..aa83a3f 100644
--- a/src/flib/CMakeLists.txt
+++ b/src/flib/CMakeLists.txt
@@ -243,7 +243,7 @@ if(NetCDF_Fortran_FOUND)
   target_include_directories(piof
     PUBLIC ${NetCDF_Fortran_INCLUDE_DIRS})
   target_link_libraries(piof
-    PUBLIC ${NetCDF_Fortran_LIBRARIES})
+    PUBLIC ${NetCDF_Fortran_LINK_LIBRARIES})
 endif()
 
 #===== PnetCDF =====
-- 
2.47.3

