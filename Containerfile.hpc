ARG BASE_IMAGE_NAME
ARG BASE_IMAGE_TAG
ARG DATA_IMAGE_NAME
ARG BINARY_DATA_TAG
ARG SOURCE_DATA_TAG
ARG COMPILER
ARG MPI
ARG GPU

FROM ${DATA_IMAGE_NAME}:${BINARY_DATA_TAG} AS binary-data
FROM ${DATA_IMAGE_NAME}:${SOURCE_DATA_TAG} AS source-data

FROM ${BASE_IMAGE_NAME}:${BASE_IMAGE_TAG} AS install-base
USER root
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/log \
    mkdir -p /working && \
    chmod 1777 /working
WORKDIR /working
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    --mount=type=cache,target=/var/cache/yum,sharing=locked \
    --mount=type=bind,source=scripts,target=/mnt/scripts,ro \
    mkdir -p /tmp/working && \
    pushd /tmp/working && \
    /mnt/scripts/install-base.sh && \
    popd && \
    rm -fr /tmp/working
ENV PATH="/opt/hpc/core/cmake/bin${PATH:+:${PATH}}"

FROM install-base AS install-drivers
ARG GPU
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    --mount=type=cache,target=/var/cache/yum,sharing=locked \
    --mount=type=bind,from=binary-data,source=drivers/cornelis-opxs/x86_64,target=/mnt/bin/drivers/cornelis-opxs,ro \
    --mount=type=bind,from=binary-data,source=drivers/intel-efs/x86_64,target=/mnt/bin/drivers/intel-efs,ro \
    --mount=type=bind,from=binary-data,source=drivers/nvidia-doca/x86_64/etc/yum.repos.d/doca.repo,target=/etc/yum.repos.d/doca.repo,ro \
    --mount=type=bind,from=binary-data,source=drivers/nvidia-doca/x86_64/usr/share/doca-host-3.2.3,target=/usr/share/doca-host-3.2.3,ro \
    --mount=type=bind,source=assets/cornelis-opxs.repo,target=/etc/yum.repos.d/cornelis-opxs.repo,ro \
    --mount=type=bind,source=assets/intel-efs.repo,target=/etc/yum.repos.d/intel-efs.repo,ro \
    --mount=type=bind,source=scripts,target=/mnt/scripts,ro \
    mkdir -p /tmp/working && \
    pushd /tmp/working && \
    /mnt/scripts/install-drivers.sh "${GPU}" && \
    popd && \
    rm -fr /tmp/working
ENV GPU="${GPU}"

FROM install-drivers AS set-default-cuda-12
ENV GPU_PREFIX="/usr/local/cuda-12"
RUN echo "# Included by /etc/ld.so.conf" >  /etc/ld.so.conf.d/hpc-drivers.conf && \
    echo "${GPU_PREFIX}/lib64"           >> /etc/ld.so.conf.d/hpc-drivers.conf && \
    ldconfig
ENV PATH="${GPU_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-drivers AS set-default-cuda-13
ENV GPU_PREFIX="/usr/local/cuda-13"
RUN echo "# Included by /etc/ld.so.conf" >  /etc/ld.so.conf.d/hpc-drivers.conf && \
    echo "${GPU_PREFIX}/lib64"           >> /etc/ld.so.conf.d/hpc-drivers.conf && \
    ldconfig
ENV PATH="${GPU_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-drivers AS set-default-none
# No GPU. Nothing to do.
ENV GPU_PREFIX="none"

FROM set-default-${GPU} AS install-infrastructure
ENV INFRASTRUCTURE_PREFIX="/opt/hpc/infrastructure"
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=bind,from=source-data,source=infrastructure,target=/mnt/src/infrastructure,ro \
    --mount=type=bind,source=patches,target=/mnt/patches,ro \
    --mount=type=bind,source=scripts,target=/mnt/scripts,ro \
    mkdir -p /tmp/working && \
    pushd /tmp/working && \
    printf "y\n" | \
        HAVE_EXTERNAL_LIBEVENT="true" \
        HAVE_EXTERNAL_NUMACTL="true" \
        /mnt/scripts/install-infrastructure.sh "${GPU}" && \
    popd && \
    rm -fr /tmp/working && \
    echo "# Included by /etc/ld.so.conf"          >  /etc/ld.so.conf.d/hpc-infrastructure.conf && \
    echo "${INFRASTRUCTURE_PREFIX}/base/lib"      >> /etc/ld.so.conf.d/hpc-infrastructure.conf && \
    echo "${INFRASTRUCTURE_PREFIX}/libcxi/lib"    >> /etc/ld.so.conf.d/hpc-infrastructure.conf && \
    echo "${INFRASTRUCTURE_PREFIX}/libfabric/lib" >> /etc/ld.so.conf.d/hpc-infrastructure.conf && \
    echo "${INFRASTRUCTURE_PREFIX}/ucc/lib"       >> /etc/ld.so.conf.d/hpc-infrastructure.conf && \
    echo "${INFRASTRUCTURE_PREFIX}/ucx/lib"       >> /etc/ld.so.conf.d/hpc-infrastructure.conf && \
    ldconfig
ENV PATH="${INFRASTRUCTURE_PREFIX}/base/bin${PATH:+:${PATH}}"
ENV PATH="${INFRASTRUCTURE_PREFIX}/libcxi/bin${PATH:+:${PATH}}"
ENV PATH="${INFRASTRUCTURE_PREFIX}/libfabric/bin${PATH:+:${PATH}}"
ENV PATH="${INFRASTRUCTURE_PREFIX}/ucc/bin${PATH:+:${PATH}}"
ENV PATH="${INFRASTRUCTURE_PREFIX}/ucx/bin${PATH:+:${PATH}}"

FROM install-infrastructure AS install-compilers
ARG COMPILER
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    --mount=type=cache,target=/var/cache/yum,sharing=locked \
    --mount=type=bind,from=binary-data,source=compilers,target=/mnt/bin/compilers,ro \
    --mount=type=bind,source=scripts,target=/mnt/scripts,ro \
    mkdir -p /tmp/working && \
    pushd /tmp/working && \
    /mnt/scripts/install-compilers.sh "${COMPILER}" && \
    popd && \
    rm -fr /tmp/working
ENV COMPILER="${COMPILER}"

FROM install-compilers AS set-default-gnu-11
# Default in RHEL 9. Nothing to do.
ENV COMPILER_PREFIX="/usr"
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
ENV PATH="${PATH:-}"

FROM install-compilers AS set-default-gnu-12
ENV COMPILER_PREFIX="/opt/rh/gcc-toolset-12/root/usr"
ENV LD_LIBRARY_PATH="${COMPILER_PREFIX}/lib64:${COMPILER_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${COMPILER_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-compilers AS set-default-gnu-13
ENV COMPILER_PREFIX="/opt/rh/gcc-toolset-13/root/usr"
ENV LD_LIBRARY_PATH="${COMPILER_PREFIX}/lib64:${COMPILER_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${COMPILER_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-compilers AS set-default-gnu-14
ENV COMPILER_PREFIX="/opt/rh/gcc-toolset-14/root/usr"
ENV LD_LIBRARY_PATH="${COMPILER_PREFIX}/lib64:${COMPILER_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${COMPILER_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-compilers AS set-default-gnu-15
ENV COMPILER_PREFIX="/opt/rh/gcc-toolset-15/root/usr"
ENV LD_LIBRARY_PATH="${COMPILER_PREFIX}/lib64:${COMPILER_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${COMPILER_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-compilers AS set-default-intel-2024
ENV COMPILER_PREFIX="/opt/intel/oneapi/compiler/latest"
ENV LD_LIBRARY_PATH="${COMPILER_PREFIX}/opt/compiler/lib:${COMPILER_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${COMPILER_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-compilers AS set-default-intel-2025
ENV COMPILER_PREFIX="/opt/intel/oneapi/compiler/latest"
ENV LD_LIBRARY_PATH="${COMPILER_PREFIX}/opt/compiler/lib:${COMPILER_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${COMPILER_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-compilers AS set-default-nvidia-2026
ENV CUDA_HOME="${GPU_PREFIX}"
ENV NVHPC_CUDA_HOME="${GPU_PREFIX}"
ENV COMPILER_PREFIX="/opt/nvidia/hpc-sdk/Linux_x86_64/2026/compilers"
ENV LD_LIBRARY_PATH="${COMPILER_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${COMPILER_PREFIX}/bin${PATH:+:${PATH}}"

FROM set-default-${COMPILER} AS install-mpi
ARG MPI
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=bind,from=binary-data,source=mpi,target=/mnt/bin/mpi,ro \
    --mount=type=bind,from=source-data,source=mpi,target=/mnt/src/mpi,ro \
    --mount=type=bind,source=patches,target=/mnt/patches,ro \
    --mount=type=bind,source=scripts,target=/mnt/scripts,ro \
    mkdir -p /tmp/working && \
    pushd /tmp/working && \
    printf "y\n" | \
        /mnt/scripts/install-mpi.sh "${COMPILER}" "${MPI}" && \
    popd && \
    rm -fr /tmp/working
ENV MPI="${MPI}"

FROM install-mpi AS set-default-intel-mpi
ENV I_MPI_ROOT="/opt/intel/oneapi/mpi/latest"
ENV MPI_PREFIX="/opt/intel/oneapi/mpi/latest"
ENV LD_LIBRARY_PATH="${MPI_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${MPI_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-mpi AS set-default-mpich-4
ENV MPI_PREFIX="/opt/hpc/compiler/${COMPILER}/${MPI}"
ENV LD_LIBRARY_PATH="${MPI_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${MPI_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-mpi AS set-default-mpich-5
ENV MPI_PREFIX="/opt/hpc/compiler/${COMPILER}/${MPI}"
ENV LD_LIBRARY_PATH="${MPI_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${MPI_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-mpi AS set-default-open-mpi-4
ENV MPI_PREFIX="/opt/hpc/compiler/${COMPILER}/${MPI}"
ENV LD_LIBRARY_PATH="${MPI_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${MPI_PREFIX}/bin${PATH:+:${PATH}}"

FROM install-mpi AS set-default-open-mpi-5
ENV MPI_PREFIX="/opt/hpc/compiler/${COMPILER}/${MPI}"
ENV LD_LIBRARY_PATH="${MPI_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV PATH="${MPI_PREFIX}/bin${PATH:+:${PATH}}"

FROM set-default-${MPI} AS hpc-container
COPY scripts/container-entrypoint.sh /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/container-entrypoint.sh"]
CMD ["/bin/bash"]
# https://specs.opencontainers.org/image-spec/annotations
LABEL "org.opencontainers.image.title"="hpc-container" \
      "org.opencontainers.image.description"="High-performance computing (HPC) containers for parallel workloads, with optimal single-/multi-node performance out of the box." \
      "org.opencontainers.image.authors"="Kuan-Chih Wang, https://github.com/kuanchihwang" \
      "org.opencontainers.image.url"="https://hub.docker.com/r/kuanchihwang/hpc-container" \
      "org.opencontainers.image.source"="https://github.com/kuanchihwang/atm-sci-container" \
      "org.opencontainers.image.licenses"="GPL-3.0-or-later"
